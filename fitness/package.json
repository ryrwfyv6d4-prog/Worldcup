{
  "name": "fitness-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal fitness & nutrition tracker (MyFitnessPal-style) — Cloudflare Worker + D1",
  "scripts": {
    "test": "node --test shared/engine.test.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create fitness-tracker",
    "db:migrate": "wrangler d1 execute fitness-tracker --remote --file=./migrations/0001_init.sql",
    "db:seed": "wrangler d1 execute fitness-tracker --remote --file=./seed/seed.sql",
    "db:migrate:local": "wrangler d1 execute fitness-tracker --local --file=./migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute fitness-tracker --local --file=./seed/seed.sql"
  },
  "devDependencies": {
    "wrangler": "^3.114.0"
  }
}
