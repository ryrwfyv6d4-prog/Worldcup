// Read by Cloudflare's own Git build (Workers Builds), which runs from the
// repo root. Without this file it deploys the repo as a static site over the
// API Worker. Keep it identical to worker/wrangler.jsonc apart from "main".
{
  "name": "worldcup",
  "main": "worker/src/index.js",
  "compatibility_date": "2024-04-05",
  "r2_buckets": [{ "binding": "WALL", "bucket_name": "dans-shed-wall" }],
  "triggers": { "crons": ["* * * * *"] }
}
